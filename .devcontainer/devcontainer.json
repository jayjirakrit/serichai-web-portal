{
  "name": "Serichai Web Portal",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },
  "workspaceFolder": "/workspace",
  "forwardPorts": [4200, 8000],
  "portsAttributes": {
    "4200": { "label": "Frontend (npm start)" },
    "8000": { "label": "Backend (uvicorn)" }
  },
  "postCreateCommand": "cd frontend && npm ci && cd ../backend && python -m venv .venv && ./.venv/bin/pip install -r requirements.txt"
}

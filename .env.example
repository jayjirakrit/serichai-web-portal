# Copy to .env and adjust as needed for your host.

# Host port the whole portal is published on (single entry point).
PORT=8080

# Host directory bind-mounted read-only into the backend container, containing
# the Excel output templates (Employee_Benefit_Template.xlsx, Bonus_Calculation_Template.xlsx).
# Defaults to the repo's own backend/data so a fresh clone works out of the box.
HOST_DATA_DIR=./backend/data

# Comma-separated list of origins the backend's CORS middleware allows.
# Only relevant to browsers calling the backend directly (e.g. local `npm start`);
# the containerized gateway proxies same-origin and isn't subject to this.
CORS_ORIGINS=http://localhost:4200
